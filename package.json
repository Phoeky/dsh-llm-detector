{
  "name": "dsh-llm-detector",
  "version": "0.2.3",
  "description": "DeepSeek Harness plugin: detect the model behind a registered provider route with a number-fingerprint challenge, a sidebar panel and a closed reference bank.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "data/detector.bin",
    "data/models.json",
    "data/LM-DETECTOR-LICENSE",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "model-fingerprint",
    "llm-detection",
    "lm-detector"
  ],
  "author": "Phoky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phoeky/dsh-llm-detector.git"
  },
  "homepage": "https://github.com/Phoeky/dsh-llm-detector#readme",
  "bugs": {
    "url": "https://github.com/Phoeky/dsh-llm-detector/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  }
}